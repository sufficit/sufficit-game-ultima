<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ultima-packages" value="pkg" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="ultima-packages">
      <package pattern="Sufficit.AI.Genius.Embedded" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
