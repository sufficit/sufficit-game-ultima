    // Arquivo escolhido: lê até 2 MB antes de enviar à Oficina.
    private async Task OnWorkshopFileInputChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _workshopFileName = file.Name;
        const long maxBytes = Workshop.MaxUploadBytes;
        if (file.Size > maxBytes) { SetWorkshopStatus("Máximo 2 MB por modelo."); _workshopFileName = string.Empty; return; }
        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await WorkshopService.UploadAsync(buffer.ToArray(), file.Name, _uploadScale, _browserLifetime.Token);
        }
        catch (Exception ex) { SetWorkshopStatus("Falha ao ler o arquivo: " + ex.Message); }
        _workshopFileName = string.Empty;
    }

    private async Task VaryAsync(string id, double? detail, int? proposedSeed = null)
    {
        SetWorkshopStatus("Remodelando…");
        StateHasChanged();
        try
