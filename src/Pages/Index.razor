@page "/"
@implements IDisposable
@using Ultima.Npc
@using Sufficit.Blazor.UI.Components
@using Sufficit.Blazor.UI.Services
@inject IJSRuntime JS
@inject HttpClient Http
@inject Ultima.Models.ModelLoader Models
@inject ISUISnackbar Snackbar

@* Interface do jogo sobre a base Sufficit.Blazor.UI (SUI).
   Painéis flutuam sobre o canvas 3D; nada de barras fixas de texto.
   Os elementos com id (game-canvas, sticks, botões A/B) são lidos pelo JS
   do jogo e nunca podem ser renderizados condicionalmente. *@
<div class="game-shell ultima-theme@((_menuOpen ? " ultima-menu-open" : "") + (_view is not null ? " ultima-dialog-open" : ""))">
    <main class="viewport">
        <canvas id="game-canvas" tabindex="0" aria-label="Mundo 3D. WASD, setas, joystick ou controles de toque movem; E/A conversa."></canvas>

        @if (!string.IsNullOrEmpty(_announcement))
        {
            <div class="ultima-toast ultima-announce" role="note">@_announcement</div>
        }

        @if (_near && _view is null)
        {
            <div class="ultima-toast ultima-hint" role="status">
                Perto da Guardiã —
                <span class="hint-kb">pressione <kbd>E</kbd></span>
                <span class="hint-pad">pressione <kbd>A</kbd> no controle</span>
                <span class="hint-touch">toque no botão <kbd>A</kbd></span>
                para conversar
            </div>
        }



        @if (_chat.Count > 0)
        {
            <section class="ultima-chat-log" aria-label="Mensagens dos jogadores" aria-live="polite">
                @foreach (var message in _chat.TakeLast(4))
                {
                    <p><strong>@message.From:</strong> @message.Text</p>
                }
            </section>
        }

        <form class="ultima-chat-compose" @onsubmit="SendChatAsync" @onsubmit:preventDefault="true">
            <label class="sr-only" for="network-chat-input">Mensagem para outros jogadores</label>
            <SUITextField TValue="string" Id="network-chat-input" Placeholder="Mensagem para outros jogadores…"
                          MaxLength="300" Immediate="true" @bind-Value="_chatDraft" />
            <SUIButton ButtonTypeValue="SUIButtonType.Submit" SizeValue="SUISize.Small" StartIcon="send"
                       aria-label="Enviar mensagem">Enviar</SUIButton>
        </form>

        @if (_menuOpen)
        {
            <button type="button" id="ultima-menu-backdrop" class="ultima-menu-backdrop" aria-label="Fechar menu"
                    @onclick="ToggleMenu"></button>
        }
        <button type="button" id="ultima-menu-fab" class="ultima-menu-fab" aria-label="@(_menuOpen ? "Fechar menu" : "Abrir menu")"
                aria-expanded="@_menuOpen.ToString().ToLower()" @onclick="ToggleMenu">☰</button>

        <div class="ultima-menu">
            <div class="ultima-menu__head">
                <strong>Menu</strong>
                <button type="button" class="ultima-menu__close" aria-label="Fechar menu" @onclick="ToggleMenu">✕</button>
            </div>
        <aside class="ultima-status" aria-label="Status do jogo">
            <SUICard Elevation="2" Class="ultima-card--glass">
                <SUICardHeader Title="@StatusTitle()" Description="@StatusSummary()">
                    <MetaContent>
                        <SUIStatusBadge ToneValue="@NetTone()">@NetLabel()</SUIStatusBadge>
                    </MetaContent>
                </SUICardHeader>
                @if (_statusExpanded)
                {
                    <SUICardContent>
                        <SUIStack Spacing="1">
                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                pos (@_posX.ToString("F1"), @_posZ.ToString("F1")) · alt @_posY.ToString("F1") · @_renderer
                            </SUIText>
                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">IA: @ActiveEngine()</SUIText>
                            @if (_devHud)
                            {
                                <SUIText Typo="SUITypo.mono" Color="SUIColor.Secondary">FPS: @_fps.ToString("0") · @_contentSource · build @BuildId</SUIText>
                                <SUIText Typo="SUITypo.mono" Color="SUIColor.Secondary">diálogos na fila: <span id="ultima-dialog-queue-count">0</span></SUIText>
                            }
                            <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Text" OnClick="ToggleStatus">Ocultar detalhes</SUIButton>
                        </SUIStack>
                    </SUICardContent>
                }
            </SUICard>
            @if (!_statusExpanded)
            {
                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Soft" OnClick="ToggleStatus" Class="ultima-status__more">detalhes</SUIButton>
            }
        </aside>

        <div class="ultima-panel-toggle">
            <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Soft" StartIcon="menu" OnClick="TogglePanel"
                       aria-label="Abrir painel do jogo">@(_panelOpen ? "Fechar" : "Painel")</SUIButton>
        </div>

        @if (_panelOpen)
        {
            <aside class="ultima-panel" aria-label="Painel do jogo">
                <SUICard Elevation="3" Class="ultima-card--glass">
                    <SUICardContent>
                        <SUIStack Spacing="2">

                            <SUIExpansionPanel Title="Multiplayer e voz" Subtitle="@NetLabel()">
                                <SUIStack Spacing="2">
                                    <SUITextField TValue="string" Id="player-name" Label="Seu nome" MaxLength="40" Immediate="true"
                                                  Value="_playerName" ValueChanged="OnPlayerNameChanged" />
                                    <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="copy"
                                               OnClick="CopyInviteAsync">Copiar convite</SUIButton>
                                    <SUISwitch Label="Transmitir minha voz" Value="_micEnabled" ValueChanged="OnMicToggled" />
                                    <SUIProgressLinear Value="@Math.Round(_micLevel * 100)" Rounded="true" ColorValue="SUIColor.Success"
                                                       AriaLabel="Nível do microfone" />
                                    <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_micStatus</SUIText>
                                    <SUISwitch Label="Ler falas em voz alta" Value="_speakEnabled" ValueChanged="OnSpeakToggled" />
                                </SUIStack>
                            </SUIExpansionPanel>

                            <SUIExpansionPanel Title="IA da Guardiã (GPU)" Subtitle="@AiShortLabel(_aiState)">
                                <SUIStack Spacing="2">
                                    @switch (_aiState)
                                    {
                                        case "checking":
                                        case "unsupported":
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiDetail</SUIText>
                                            break;
                                        case "ready":
                                            <SUIStack Row="true" Spacing="2" AlignItems="center" Wrap="true">
                                                <SUIStatusBadge ToneValue="SUITone.Success" Icon="check">IA local pronta</SUIStatusBadge>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="DisableAiAsync">Desligar</SUIButton>
                                            </SUIStack>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiDetail</SUIText>
                                            break;
                                        case "thinking":
                                            <SUIStatusBadge ToneValue="SUITone.Info">Pensando…</SUIStatusBadge>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiDetail</SUIText>
                                            break;
                                        case "model":
                                        case "downloading":
                                        case "compiling":
                                        case "stalled":
                                            <SUIProgressLinear Value="@Math.Round(_aiProgress * 100)" Rounded="true" AriaLabel="Progresso do modelo de IA" />
                                            <SUIText Typo="SUITypo.caption">@((int)(_aiProgress * 100))% · @_aiDetail</SUIText>
                                            @if (_aiState == "stalled")
                                            {
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="RetryAiAsync">Tentar de novo</SUIButton>
                                            }
                                            break;
                                        case "error":
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Error">@_aiDetail</SUIText>
                                            <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="RetryAiAsync">Tentar de novo</SUIButton>
                                            break;
                                        default:
                                            <SUIButton SizeValue="SUISize.Small" OnClick="EnableAiAsync">Ativar IA na minha GPU</SUIButton>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">Roda no seu navegador, sem enviar a conversa. @_aiDetail</SUIText>
                                            break;
                                    }
                                </SUIStack>
                            </SUIExpansionPanel>

                            <SUIExpansionPanel Title="IA na CPU (sem placa de vídeo)" Subtitle="@AiShortLabel(_aiCpuState)">
                                <SUIStack Spacing="2">
                                    <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">Motor ativo: @ActiveEngine()</SUIText>
                                    @if (_aiCpuState != "ready")
                                    {
                                        <div class="ultima-models" role="group" aria-label="Escolher modelo da IA na CPU">
                                            @foreach (var kv in AiCpuModels)
                                            {
                                                var selected = kv.Key == _aiCpuModel;
                                                <SUIButton SizeValue="SUISize.Small" FullWidth="true"
                                                           VariantValue="@(selected ? SUIVariant.Soft : SUIVariant.Outlined)"
                                                           Class="@(selected ? "ultima-model-btn ultima-model-btn--on" : "ultima-model-btn")"
                                                           OnClick="@(() => SelectAiCpuModelAsync(kv.Key))"
                                                           aria-pressed="@(selected ? "true" : "false")">
                                                    @kv.Value.Label · @kv.Value.Why
                                                </SUIButton>
                                            }
                                        </div>
                                    }
                                    @switch (_aiCpuState)
                                    {
                                        case "ready":
                                            <SUIStack Row="true" Spacing="2" AlignItems="center" Wrap="true">
                                                <SUIStatusBadge ToneValue="SUITone.Success" Icon="check">IA na CPU pronta</SUIStatusBadge>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="DisableAiCpuAsync">Desligar</SUIButton>
                                            </SUIStack>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiCpuDetail</SUIText>
                                            break;
                                        case "thinking":
                                            <SUIStatusBadge ToneValue="SUITone.Info">Pensando…</SUIStatusBadge>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiCpuDetail</SUIText>
                                            break;
                                        case "model":
                                        case "downloading":
                                        case "loading":
                                        case "stalled":
                                            <SUIProgressLinear Value="@Math.Round(_aiCpuProgress * 100)" Rounded="true" AriaLabel="Progresso do modelo de IA na CPU" />
                                            <SUIText Typo="SUITypo.caption">@((int)(_aiCpuProgress * 100))% · @_aiCpuDetail</SUIText>
                                            @if (_aiCpuState == "stalled")
                                            {
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="RetryAiCpuAsync">Tentar de novo</SUIButton>
                                            }
                                            break;
                                        case "error":
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Error">@_aiCpuDetail</SUIText>
                                            <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="RetryAiCpuAsync">Tentar de novo</SUIButton>
                                            break;
                                        default:
                                            <SUIButton SizeValue="SUISize.Small" OnClick="EnableAiCpuAsync">Ativar IA na minha CPU</SUIButton>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiCpuDetail</SUIText>
                                            break;
                                    }
                                </SUIStack>
                            </SUIExpansionPanel>

                            <SUIExpansionPanel Title="Controles e ajuda">
                                <SUIStack Spacing="2">
                                    <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                        teclado: <kbd>WASD</kbd>/<kbd>↑↓←→</kbd> andar · <kbd>E</kbd> conversa · <kbd>Esc</kbd> fecha · mouse gira a câmera
                                    </SUIText>
                                    <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                        controle: <kbd>LS</kbd> mover · <kbd>RS</kbd> câmera · botão <kbd>Ⓐ</kbd>/<kbd>✕</kbd> conversar · celular: analógicos na tela
                                    </SUIText>
                                    <SUISwitch Label="Informações de desenvolvimento (FPS, fonte do conteúdo)" Value="_devHud" ValueChanged="OnDevToggled" />
                                    <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="restart" OnClick="Restart">Voltar ao início da trilha</SUIButton>
                                </SUIStack>
                            </SUIExpansionPanel>

                        </SUIStack>
                    </SUICardContent>
                </SUICard>
            </aside>
        }

        <aside class="workshop-panel" aria-label="Oficina do mundo">
            <details>
                <summary><strong>Oficina do mundo</strong><span>@_workshopStatus</span></summary>
                <section class="ws-block">
                    <strong>Variações do cenário</strong>
                    <small>O mundo se remodela na hora — mesmo motor paramétrico das árvores, pedras e grama.</small>
                    <div class="ws-actions">
                        <button type="button" class="secondary" @onclick='() => VaryAsync("tree.pine", null)'>🌲 Árvores novas</button>
                        <button type="button" class="secondary" @onclick='() => VaryAsync("tree.pine", 1.6)'>Densas</button>
                        <button type="button" class="secondary" @onclick='() => VaryAsync("tree.pine", 0.6)'>Jovens</button>
                        <button type="button" class="secondary" @onclick='() => VaryAsync("rock.boulder", null)'>🪨 Pedras novas</button>
                        <button type="button" class="secondary" @onclick='() => VaryAsync("scenery.grass", 1.4)'>🌱 Grama exuberante</button>
                    </div>
                </section>
                <section class="ws-block">
                    <strong>Criar modelo</strong>
                    <small>Descreva e o servidor gera um GLB (SHA-256 verificado) plantado no mundo compartilhado.</small>
                    <div class="ws-row">
                        <input id="workshop-prompt" @bind="_promptDraft" @bind:event="oninput" maxlength="120" placeholder="ex.: cristal encantado azul" autocomplete="off" />
                        <button type="button" @onclick="GenerateAsync">Gerar</button>
                    </div>
                </section>
                <section class="ws-block">
                    <strong>Enviar modelo (.glb)</strong>
                    <small>Até 2 MB e 30 mil triângulos; validado no servidor e publicado para todos os jogadores.</small>
                    <div class="ws-row">
                        <input type="file" accept=".glb,model/gltf-binary" onchange="game.workshop.upload(this)" />
                        <input id="workshop-scale" type="number" min="0.05" max="12" step="0.05" value="1" title="Tamanho em metros (maior dimensão)" aria-label="Tamanho em metros" />
                    </div>
                </section>
                <section class="ws-block">
                    <strong>Estilo do mundo</strong>
                    <div class="ws-actions">
                        <button type="button" class='chip @(_sceneryStyle == "procedural" ? "ok-chip" : null)' aria-pressed='@(_sceneryStyle == "procedural")' @onclick='() => SetSceneryAsync("procedural")'>Procedural (padrão)</button>
                        <button type="button" class='chip @(_sceneryStyle == "lowpoly" ? "ok-chip" : null)' aria-pressed='@(_sceneryStyle == "lowpoly")' @onclick='() => SetSceneryAsync("lowpoly")'>Low-poly CC0</button>
                        @if (_sceneryDirty)
                        {
                            <button type="button" class="secondary" @onclick="ReloadPage">Recarregar para aplicar</button>
                        }
                    </div>
                </section>
            </details>
        </aside>
        </div><!-- /.ultima-menu -->

        <div class="touch-controls" aria-label="Controles táteis">
            <div id="move-stick" class="touch-stick" aria-label="Analógico para andar"><span id="move-thumb"></span><small>ANDAR</small></div>
            <div class="touch-right-controls">
                <div id="look-stick" class="touch-stick look-stick" aria-label="Analógico para câmera"><span id="look-thumb"></span><small>CÂMERA</small></div>
                <button id="touch-cancel" type="button" aria-label="Fechar diálogo">B</button>
                <button id="touch-action" type="button" aria-label="Conversar com a Guardiã">A</button>
            </div>
        </div>

        @if (_view is not null)
        {
            <section class="ultima-dialog" role="dialog" aria-modal="false" aria-label="Conversa com a Guardiã">
                <SUICard Elevation="3" Class="ultima-card--glass">
                    <SUICardContent>
                        <SUIStack Spacing="2">
                            <p class="ultima-dialog__speaker">@_view.Lines[_view.CurrentLine].Speaker</p>
                            <p class="ultima-dialog__line" aria-live="polite">@_view.Lines[_view.CurrentLine].Text</p>
                            @if (!_view.Thinking && !string.IsNullOrEmpty(_view.ReplySource) && _view.Lines[_view.CurrentLine].Speaker != "Você")
                            {
                                <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">✦ origem da resposta: @_view.ReplySource</SUIText>
                            }
                            <form class="ultima-dialog__compose" @onsubmit="SubmitDialogAsync" @onsubmit:preventDefault="true">
                                <label class="sr-only" for="dialog-input">Escreva para a Guardiã</label>
                                <SUITextField TValue="string" Id="dialog-input" Placeholder="Escreva algo para a Guardiã…"
                                              MaxLength="300" Immediate="true" @bind-Value="_dialogDraft" />
                                <SUIButton ButtonTypeValue="SUIButtonType.Submit" SizeValue="SUISize.Small" StartIcon="send"
                                           aria-label="Enviar para a Guardiã">Enviar</SUIButton>
                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="audio"
                                           OnClick="ToggleDictationAsync">@(_dictating ? "Parar ditado" : "Ditar")</SUIButton>
                            </form>
                            @if (!string.IsNullOrEmpty(_speechError))
                            {
                                <SUIText Typo="SUITypo.caption" Color="SUIColor.Error">@_speechError</SUIText>
                            }
                            <SUIStack Row="true" Spacing="2" Wrap="true">
                                <SUIButton OnClick="AdvanceAsync">@(_view.CurrentLine + 1 < _view.Lines.Count ? "Continuar · E/A" : "Encerrar · E/A")</SUIButton>
                                <SUIButton VariantValue="SUIVariant.Outlined" OnClick="CloseDialog">Fechar · Esc</SUIButton>
                            </SUIStack>
                        </SUIStack>
                    </SUICardContent>
                </SUICard>
            </section>
        }
    </main>
</div>

@code {
    private DotNetObjectReference<GameInterop>? _bridge;
    private DotNetObjectReference<Ultima.Models.ModelsInterop>? _modelsRef;
    private string _renderer = string.Empty;
    private bool _near;
    private DialogView? _view;
    private readonly NpcScheduler _npc = new();
    private double _posX, _posY, _posZ, _fps, _micLevel;
    private int _remoteCount;
    private string? _announcement;
    private string _contentSource = "Conteúdo local";
    private string _netStatus = "Conectando…";
    private string _micStatus = "Microfone desligado; o áudio só é transmitido quando você ativa a voz.";
    private string _speechError = string.Empty;
    private string _dialogDraft = string.Empty;
    private string _chatDraft = string.Empty;
    private string _playerName = string.Empty;
    private bool _micEnabled;
    private bool _speakEnabled;
    private bool _dictating;
    private bool _statusExpanded;
    private bool _panelOpen;
    private bool _menuOpen;
    private bool _devHud;
    private long _turnStartedMs;   // t50: base do tempo de resposta registrado por turno
    private readonly List<ChatMessage> _chat = [];
    private sealed record ChatMessage(string From, string Text);

    private const string ContentApi = "https://w-5bee2eba74174628a92a487c6a938f9b.run.sufficit.com.br";
    private sealed record NpcDto(string? DisplayName, string[]? Lines);
    private readonly string _chatSession = Guid.NewGuid().ToString("N");
    private string _aiState = "off";
    private double _aiProgress;
    private string _aiDetail = string.Empty;
    private string _aiCpuState = "off";
    private double _aiCpuProgress;
    private string _aiCpuDetail = string.Empty;

    // --- Oficina do mundo (PLAN-PLAYER-ASSETS): variações, geração, upload, estilo ---
    private string _workshopStatus = "abrir para remodelar";
    private string _promptDraft = string.Empty;
    private string _sceneryStyle = "procedural";
    private bool _sceneryDirty;

    private async Task VaryAsync(string id, double? detail)
    {
        _workshopStatus = "Remodelando…";
        StateHasChanged();
        try
        {
            var seed = Random.Shared.Next();
            var ok = await JS.InvokeAsync<bool>("game.models.vary", id, new { seed, detail = detail ?? 1.0 });
            _workshopStatus = ok ? "✓ cenário atualizado" : "Não foi possível trocar (modelo DLL ausente)";
        }
        catch (Exception ex)
        {
            _workshopStatus = "Falhou: " + ex.Message;
        }
    }

    private async Task GenerateAsync()
    {
        if (string.IsNullOrWhiteSpace(_promptDraft)) { return; }
        var prompt = _promptDraft;
        _workshopStatus = "Gerando…";
        StateHasChanged();
        try { _workshopStatus = await JS.InvokeAsync<string>("game.workshop.generate", prompt); }
        catch (Exception ex) { _workshopStatus = "Falhou: " + ex.Message; }
        _promptDraft = string.Empty;
    }

    private async Task SetSceneryAsync(string style)
    {
        _sceneryStyle = await JS.InvokeAsync<string>("game.scenery.set", style);
        _sceneryDirty = true;
    }

    private Task ReloadPage() => JS.InvokeVoidAsync("location.reload").AsTask();
    private Task EnableAiAsync() => JS.InvokeVoidAsync("game.ai.load").AsTask();
    private Task DisableAiAsync() => JS.InvokeVoidAsync("game.ai.disable").AsTask();
    private Task RetryAiAsync() => JS.InvokeVoidAsync("game.ai.retry").AsTask();
    private Task EnableAiCpuAsync() => JS.InvokeVoidAsync("game.aiCpu.load").AsTask();
    private Task DisableAiCpuAsync() => JS.InvokeVoidAsync("game.aiCpu.disable").AsTask();
    private Task RetryAiCpuAsync() => JS.InvokeVoidAsync("game.aiCpu.retry").AsTask();
    private string _aiCpuModel = "gemma270";
    // Dois modelos, propostas diferentes (t48): leveza máxima vs. melhor conversa em português.
    private static readonly Dictionary<string, (string Label, string Why)> AiCpuModels = new()
    {
        ["gemma270"] = ("Gemma 3 270M", "leve, ~241 MB, rápido"),
        ["qwen05b"] = ("Qwen2.5 0.5B", "melhor português, ~469 MB"),
    };
    private Task SelectAiCpuModelAsync(string key)
    {
        _aiCpuModel = key;
        return JS.InvokeVoidAsync("game.aiCpu.setModel", key).AsTask();
    }
    private string ActiveEngine() => _aiState == "ready" ? "webgpu" : _aiCpuState == "ready" ? "cpu-wllama" : "servidor (regras)";

    // --- Rótulos compactos da interface SUI ---
    private string BuildId = "dev";
    private string StatusTitle() => string.IsNullOrWhiteSpace(_playerName) ? "Ultima" : (_playerName.Length > 24 ? _playerName[..24] : _playerName);
    private string StatusSummary() => $"{ActiveEngine()} · {_remoteCount} jogador(es) remoto(s)";
    private string NetLabel()
    {
        var label = string.IsNullOrEmpty(_renderer) ? _netStatus : _netStatus;
        return label.Length > 30 ? label[..30] + "…" : label;
    }
    private Sufficit.Blazor.UI.Components.SUITone NetTone() => _netStatus.Contains("Conectad", StringComparison.OrdinalIgnoreCase) ? Sufficit.Blazor.UI.Components.SUITone.Success
        : _netStatus.Contains("Conectando", StringComparison.OrdinalIgnoreCase) ? Sufficit.Blazor.UI.Components.SUITone.Info
        : _netStatus.Contains("falha", StringComparison.OrdinalIgnoreCase) || _netStatus.Contains("erro", StringComparison.OrdinalIgnoreCase) ? Sufficit.Blazor.UI.Components.SUITone.Danger
        : Sufficit.Blazor.UI.Components.SUITone.Neutral;
    private static string AiShortLabel(string state) => state switch
    {
        "ready" => "pronta",
        "thinking" => "pensando…",
        "model" => "escolhendo modelo…",
        "downloading" => "baixando…",
        "loading" => "carregando…",
        "compiling" => "compilando…",
        "stalled" => "travou",
        "error" => "erro",
        "checking" => "verificando…",
        "unsupported" => "sem WebGPU",
        _ => "desligada",
    };
    private void ToggleStatus() => _statusExpanded = !_statusExpanded;
    private void TogglePanel() => _panelOpen = !_panelOpen;
    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void OnDevToggled(bool value) => _devHud = value;

    private sealed record AnnouncementDto(string? Text);
    private sealed record AnnouncementsDto(AnnouncementDto[]? Items);

    protected override void OnInitialized()
    {
        var interop = new GameInterop
        {
            EngineReady = renderer => _ = InvokeAsync(() => { _renderer = renderer; StateHasChanged(); }),
            NearChanged = near => _ = InvokeAsync(() => { _near = near; StateHasChanged(); }),
            Interact = () => _ = InvokeAsync(OnInteractAsync),
            Close = () => _ = InvokeAsync(CloseDialog),
            MoveTick = (x, y, z, fps) => _ = InvokeAsync(() => { _posX = x; _posY = y; _posZ = z; _fps = fps; RunNpcTick(); StateHasChanged(); }),
            NetStatus = (state, peers) => _ = InvokeAsync(() => { _netStatus = state; StateHasChanged(); }),
            Chat = (from, text) => _ = InvokeAsync(() => { AddChat(from, text); StateHasChanged(); }),
            RemoteCount = count => _ = InvokeAsync(() => { _remoteCount = count; StateHasChanged(); }),
            MicState = state => _ = InvokeAsync(() => { _micEnabled = state == "ligada"; _micStatus = state; StateHasChanged(); }),
            MicLevel = level => _ = InvokeAsync(() => { _micLevel = Math.Clamp(level, 0, 1); StateHasChanged(); }),
            SpeechTranscript = text => _ = InvokeAsync(() => { _dialogDraft = text; StateHasChanged(); }),
            SpeechError = message => _ = InvokeAsync(() => { _speechError = message; StateHasChanged(); }),
            Dictation = listening => _ = InvokeAsync(() => { _dictating = listening; StateHasChanged(); }),
            AiState = (state, progress, detail) => _ = InvokeAsync(() => { _aiState = state; _aiProgress = progress; _aiDetail = detail; StateHasChanged(); }),
            AiCpuState = (state, progress, detail) => _ = InvokeAsync(() => { _aiCpuState = state; _aiCpuProgress = progress; _aiCpuDetail = detail; StateHasChanged(); }),
            WorkshopStatus = message => _ = InvokeAsync(() => { _workshopStatus = message; StateHasChanged(); })
        };
        _bridge = DotNetObjectReference.Create(interop);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _bridge is null) return;

        _modelsRef = DotNetObjectReference.Create(new Ultima.Models.ModelsInterop(Models));
        await JS.InvokeVoidAsync("game.init", "game-canvas", _bridge, _modelsRef);
        _ = Models.LoadAllAsync();   // modelos 3D (DLLs C#) chegam em paralelo e entram na cena
        await JS.InvokeVoidAsync("game.net.init", _bridge);
        await JS.InvokeVoidAsync("game.live.init", _bridge);
        await JS.InvokeVoidAsync("game.voice.init", _bridge);
        await JS.InvokeVoidAsync("game.ai.init", _bridge);
        await JS.InvokeVoidAsync("game.aiCpu.init", _bridge);
        try { await JS.InvokeVoidAsync("game.workshop.init", _bridge); }
        catch (JSException) { /* oficina é opcional: motor antigo não a expõe */ }
        try { await JS.InvokeVoidAsync("game.dialogLog.init"); }
        catch (JSException) { /* registro de conversas é opcional */ }
        // Cada módulo JS é opcional: um ausente não pode derrubar a interface
        // (a dica de controles e o conteúdo remoto precisam rodar mesmo assim).
        try { _speakEnabled = await JS.InvokeAsync<bool>("game.voice.getSpeakPref"); }
        catch (JSException) { _speakEnabled = false; }
        try { _playerName = await JS.InvokeAsync<string?>("game.net.getName"); }
        catch (JSException) { _playerName = null; }
        try { _sceneryStyle = await JS.InvokeAsync<string>("game.scenery.get") ?? "procedural"; }
        catch (JSException) { _sceneryStyle = "procedural"; }
        try
        {
            BuildId = await JS.InvokeAsync<string>("game.build") is { Length: > 0 } b ? b[..Math.Min(10, b.Length)] : "dev";
        }
        catch (JSException) { BuildId = "dev"; } // game.build não existe em todos os builds; o id é só do HUD de dev
        // Dica de controles como mensagem transitória (snackbar SUI), não bloco fixo na tela.
        Snackbar.Info("WASD/setas andam · E conversa · Esc fecha · Painel abre multiplayer, IA e ajuda");
        StateHasChanged();
        _ = LoadRemoteContentAsync();
    }

    private async Task LoadRemoteContentAsync()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3));
            var npcRequest = Http.GetFromJsonAsync<NpcDto>($"{ContentApi}/v1/npcs/guardia", cts.Token);
            var announcementsRequest = Http.GetFromJsonAsync<AnnouncementsDto>($"{ContentApi}/v1/announcements", cts.Token);
            await Task.WhenAll(npcRequest, announcementsRequest);
            var npc = await npcRequest;
            var announcements = await announcementsRequest;
                await InvokeAsync(() =>
                {
                    if (npc?.Lines is { Length: > 0 and <= 50 } remoteLines &&
                        remoteLines.All(line => !string.IsNullOrWhiteSpace(line) && line.Length <= 1000))
                    {
                        var name = string.IsNullOrWhiteSpace(npc.DisplayName) ? "Guardiã do Jardim" : npc.DisplayName;
                        // As falas passam a morar no cérebro da Guardiã: chegam como evento.
                        _npc.Submit(new IntroLinesChanged(NowMs(), name!, remoteLines));
                        RunNpcTick();
                    }
                    _announcement = announcements?.Items?.FirstOrDefault(item => !string.IsNullOrWhiteSpace(item.Text) && item.Text.Length <= 300)?.Text;
                    _contentSource = "Conteúdo remoto";
                    StateHasChanged();
                });
        }
        catch (Exception) { /* API offline: falas locais e jogo continuam funcionando. */ }
    }

    // --- Diálogo via IA de NPCs: eventos -> agendador com budget -> decisões ---
    // O cérebro da Guardiã (GuardianBrain) decide sobre um snapshot do mundo; a UI é
    // casca que aplica os comandos. A WebLLM e a API são produtores externos de
    // respostas: chegam como ReplyArrived pela fila, nunca bloqueiam o tick.

    private static long NowMs() => DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

    private bool PlayerNearWanderer() => _remoteCount > 0;

    private WorldSnapshot Snapshot() => new(_posX, _posZ, _near, PlayerNearWanderer(), _view is not null, _aiState == "ready", NowMs());

    private void Dispatch(GameEvent e)
    {
        _npc.Submit(e);
        RunNpcTick();
    }

    // Batida do agendador: o que não coube no orçamento do tick anterior retoma aqui
    // (chamado também pelo MoveTick do loop de jogo, a 5 Hz).
    private void RunNpcTick()
    {
        if (_npc.PendingEvents == 0) { return; }
        foreach (var decision in _npc.Tick(Snapshot()))
        {
            ApplyDecision(decision);
        }
    }

    private void ApplyDecision(NpcDecision decision)
    {
        if (decision.View is not null)
        {
            _view = decision.View.CurrentLine >= 0 ? decision.View : null;
        }
        foreach (var command in decision.Commands)
        {
            switch (command)
            {
                case OpenDialog:
                    _ = SetFrozen(true);
                    break;
                case Ultima.Npc.CloseDialog:
                    _view = null;
                    _ = JS.InvokeVoidAsync("game.voice.stopDictation");
                    _ = SetFrozen(false);
                    break;
                case ShowLine(int index):
                    _ = SpeakLineAsync(decision.View!.Lines[index]);
                    break;
                case SetReply(int index, var text, _):
                    _ = SpeakLineAsync(new DialogLine(decision.View!.Lines[index].Speaker, text));
                    // t50: funil único do registro de conversas — chega aqui todo turno com
                    // resposta (roteiro, chat da Guardiã ou IA local); a pergunta do jogador
                    // é a linha anterior do mesmo diálogo. O módulo JS sanitiza e enfileira.
                    try
                    {
                        var dlg = decision.View;
                        var playerLine = index > 0 && dlg.Lines[index - 1].Speaker == "Você"
                            ? dlg.Lines[index - 1].Text : string.Empty;
                        var ms = _turnStartedMs > 0 ? (long)(NowMs() - _turnStartedMs) : 0;
                        _ = JS.InvokeVoidAsync("game.dialogLog.turn",
                            dlg.Speaker, playerLine, text, dlg.ReplySource, ms);
                    }
                    catch (JSException) { /* registro é opcional: nunca atrapalha o diálogo */ }
                    break;
            }
        }
        StateHasChanged();
    }

    private Task OnInteractAsync() { Dispatch(new PlayerInteracted(NowMs())); return Task.CompletedTask; }

    private Task AdvanceAsync() { Dispatch(new PlayerInteracted(NowMs())); return Task.CompletedTask; }

    private async Task SubmitDialogAsync()
    {
        var text = _dialogDraft.Trim();
        if (_view is null || _view.Thinking || text.Length == 0) return;
        if (text.Length > 300) text = text[..300];
        _dialogDraft = string.Empty;
        _speechError = string.Empty;
        _turnStartedMs = NowMs();   // t50: base do tempo de resposta do turno registrado
        Dispatch(new PlayerSpoke(NowMs(), text));
        // Produtores caros (WebLLM na GPU, API do jogo, fallback local) correm fora do
        // tick; a resposta vira evento e o cérebro a aplica em um tick futuro.
        var (reply, source) = await AskGuardianAsync(text);
        Dispatch(new ReplyArrived(NowMs(), reply, source));
    }

    // A Guardiã responde pela API do jogo (IA quando configurada, regras caso contrário);
    // sem rede, cai numa resposta local para o diálogo nunca travar. Cada origem é marcada.
    private async Task<(string Reply, string Source)> AskGuardianAsync(string text)
    {
        // Cadeia de resposta local: GPU (WebGPU/WebLLM) → CPU (wllama WASM) → servidor (regras).
        // O motor efetivamente usado aparece na origem marcada de cada resposta.
        if (_aiState == "ready")
        {
            try
            {
                var local = await JS.InvokeAsync<string?>("game.ai.ask", TimeSpan.FromSeconds(60), text, _playerName ?? string.Empty);
                if (!string.IsNullOrWhiteSpace(local))
                {
                    return (local!.Length > 500 ? local[..500] : local, "GPU do jogador (modelo local)");
                }
            }
            catch (Exception ex) { Console.WriteLine($"[ia] local falhou: {ex.GetType().Name}: {ex.Message}"); }
        }
        if (_aiCpuState == "ready")
        {
            try
            {
                var localCpu = await JS.InvokeAsync<string?>("game.aiCpu.ask", TimeSpan.FromSeconds(120), text, _playerName ?? string.Empty);
                if (!string.IsNullOrWhiteSpace(localCpu))
                {
                    return (localCpu!.Length > 500 ? localCpu[..500] : localCpu, "CPU do jogador (modelo local WASM)");
                }
            }
            catch (Exception ex) { Console.WriteLine($"[ia-cpu] local falhou: {ex.GetType().Name}: {ex.Message}"); }
        }
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            // JSON montado/lido sem reflexão: imune ao trimming do build Release.
            var payload = new Dictionary<string, string>
            {
                ["message"] = text,
                ["session"] = _chatSession,
                ["player"] = _playerName ?? string.Empty
            };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            using var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            using var res = await Http.PostAsync($"{ContentApi}/v1/npcs/guardia/chat", content, cts.Token);
            var raw = await res.Content.ReadAsStringAsync(cts.Token);
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            if (doc.RootElement.TryGetProperty("reply", out var r) && r.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var reply = r.GetString();
                if (!string.IsNullOrWhiteSpace(reply))
                {
                    var origin = "servidor do jogo";
                    if (doc.RootElement.TryGetProperty("source", out var s) && s.ValueKind == System.Text.Json.JsonValueKind.String)
                    {
                        var src = s.GetString();
                        origin = src == "rules" ? "servidor · regras" : $"servidor · {src}";
                    }
                    return (reply!.Length > 500 ? reply[..500] : reply, origin);
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"[npc] chat falhou: {ex.GetType().Name}: {ex.Message}"); }
        return ("Os ventos do jardim estão agitados e mal ouço você. Tente de novo em instantes, caminhante.", "falas locais do jogo (sem rede)");
    }

    private void CloseDialog()
    {
        if (_view is null) return;
        _npc.Submit(new DialogClosedByPlayer(NowMs()));   // sincroniza o cérebro sem tick extra
        _view = null;
        _ = JS.InvokeVoidAsync("game.voice.stopDictation");
        _ = SetFrozen(false);
        StateHasChanged();
    }

    private Task SpeakLineAsync(DialogLine line) =>
        _speakEnabled ? JS.InvokeVoidAsync("game.voice.speak", line.Text, line.Speaker).AsTask() : Task.CompletedTask;

    private async Task OnSpeakToggled(bool enabled)
    {
        _speakEnabled = enabled;
        await JS.InvokeVoidAsync("game.voice.setSpeakPref", _speakEnabled);
        if (_speakEnabled && _view is not null) await SpeakLineAsync(_view.Lines[_view.CurrentLine]);
    }

    private async Task ToggleDictationAsync()
    {
        _speechError = string.Empty;
        if (_dictating) await JS.InvokeVoidAsync("game.voice.stopDictation");
        else await JS.InvokeVoidAsync("game.voice.startDictation");
    }

    private async Task OnMicToggled(bool enabled)
    {
        if (enabled) await JS.InvokeVoidAsync("game.voice.startMic");
        else await JS.InvokeVoidAsync("game.voice.stopMic");
    }

    private async Task OnPlayerNameChanged(string value)
    {
        _playerName = value;
        await JS.InvokeVoidAsync("game.net.setName", _playerName);
    }

    private async Task CopyInviteAsync()
    {
        var result = await JS.InvokeAsync<string>("game.net.copyInvite");
        _netStatus = result;
    }

    private async Task SendChatAsync()
    {
        var text = _chatDraft.Trim();
        if (text.Length == 0) return;
        _chatDraft = string.Empty;
        AddChat("Você", text);
        await JS.InvokeVoidAsync("game.net.sendChat", text);
    }

    private void AddChat(string from, string text)
    {
        _chat.Add(new ChatMessage(from.Length > 40 ? from[..40] : from, text.Length > 300 ? text[..300] : text));
        if (_chat.Count > 30) _chat.RemoveAt(0);
    }

    private async Task Restart()
    {
        if (_view is not null)
        {
            _npc.Submit(new DialogClosedByPlayer(NowMs()));
            _view = null;
            await SetFrozen(false);
        }
        await JS.InvokeVoidAsync("game.resetPlayer");
    }

    private Task SetFrozen(bool frozen) => JS.InvokeVoidAsync("game.setFrozen", frozen).AsTask();

    public void Dispose()
    {
        _bridge?.Dispose();
        _modelsRef?.Dispose();
    }
}
