        : _netStatus.Contains("falha", StringComparison.OrdinalIgnoreCase) || _netStatus.Contains("erro", StringComparison.OrdinalIgnoreCase) ? Sufficit.Blazor.UI.Components.SUITone.Danger
        : Sufficit.Blazor.UI.Components.SUITone.Neutral;
