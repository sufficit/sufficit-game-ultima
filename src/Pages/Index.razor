        var prompt = _promptDraft;
        SetWorkshopStatus("Gerando…");
        StateHasChanged();
        try { SetWorkshopStatus(await WorkshopService.GenerateAsync(prompt, _browserLifetime.Token)); }
        catch (Exception ex) { SetWorkshopStatus("Falhou: " + ex.Message); }
        _promptDraft = string.Empty;
    }

