    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _bridge is null) return;

        await GameUpdates.InitializeAsync(_browserLifetime.Token);
        BuildId = GameUpdates.Build.StartsWith("__", StringComparison.Ordinal) ? "dev"
            : GameUpdates.Build[..Math.Min(10, GameUpdates.Build.Length)];
        _ = GameUpdates.WatchAsync(ShowUpdate, _browserLifetime.Token);
        _modelsRef = DotNetObjectReference.Create(new Ultima.Models.ModelsInterop(Models));
        var motorOk = false;
        try
        {
            motorOk = await JS.InvokeAsync<bool>("game.init", "game-canvas", _bridge, _modelsRef);
        }
        catch (JSException ex)
        {
            _workshopStatus = "Motor 3D indisponível: " + ex.Message;   // UI viva; o shell mostra detalhes
        }
        if (!motorOk)
        {
            return;   // sem motor não há o que registrar — evita o spam de "cena ainda não criada"
        }
        await JS.InvokeVoidAsync("game.backpack.init", _bridge);
        await BackpackState.SynchronizeAsync();
        _ = Models.LoadAllAsync();   // modelos 3D (DLLs C#) chegam em paralelo e entram na cena
        await JS.InvokeVoidAsync("game.net.init", _bridge);
        await JS.InvokeVoidAsync("game.live.init", _bridge);
        _ = Live.RunAsync(_browserLifetime.Token);
        _ = WorldTime.RunAsync(_browserLifetime.Token);
        await JS.InvokeVoidAsync("game.voice.init", _bridge);
        await JS.InvokeVoidAsync("game.ai.init", _bridge);
        await JS.InvokeVoidAsync("game.aiCpu.init", _bridge);
        _ = WorkshopService.WatchAsync(_browserLifetime.Token);
        try
        {
            await Dialogs.InitializeAsync(GameUpdates.Build, _browserLifetime.Token);
            await JS.InvokeVoidAsync("game.dialogLog.init", _bridge);
            _ = Dialogs.WatchAsync(_browserLifetime.Token);
        }
        catch (JSException) { /* registro de conversas é opcional */ }
        // Cada módulo JS é opcional: um ausente não pode derrubar a interface
        // (a dica de controles e o conteúdo remoto precisam rodar mesmo assim).
        try { _speakEnabled = await JS.InvokeAsync<bool>("game.voice.getSpeakPref"); }
        catch (JSException) { _speakEnabled = false; }
        try { _playerName = await JS.InvokeAsync<string?>("game.net.getName") ?? string.Empty; }
        catch (JSException) { _playerName = string.Empty; }
        try { _sceneryStyle = await JS.InvokeAsync<string>("game.scenery.get") ?? "procedural"; }
        catch (JSException) { _sceneryStyle = "procedural"; }
        try { _gfxStyle = await JS.InvokeAsync<string>("game.graphics.get"); }
        catch (JSException) { _gfxStyle = "padrao"; }
        // Dica de controles como mensagem transitória (snackbar SUI), não bloco fixo na tela.
        Snackbar.Info("WASD/setas andam · Shift corre · E conversa · Esc fecha");
        StateHasChanged();
        _ = LoadRemoteContentAsync();
    }

    private async Task LoadRemoteContentAsync()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3));
            var npcRequest = Http.GetFromJsonAsync<NpcDto>($"{ContentApi}/v1/npcs/guardia", cts.Token);
            var announcementsRequest = Http.GetFromJsonAsync<AnnouncementsDto>($"{ContentApi}/v1/announcements", cts.Token);
            await Task.WhenAll(npcRequest, announcementsRequest);
            var npc = await npcRequest;
            var announcements = await announcementsRequest;
                await InvokeAsync(() =>
                {
                    if (npc?.Lines is { Length: > 0 and <= 50 } remoteLines &&
                        remoteLines.All(line => !string.IsNullOrWhiteSpace(line) && line.Length <= 1000))
                    {
                        var name = string.IsNullOrWhiteSpace(npc.DisplayName) ? "Guardiã do Jardim" : npc.DisplayName;
                        // As falas passam a morar no cérebro da Guardiã: chegam como evento.
                        _npc.Submit(new IntroLinesChanged(NowMs(), name!, remoteLines));
                        RunNpcTick();
                    }
                    ShowAnnouncement(announcements?.Items?.FirstOrDefault(item => !string.IsNullOrWhiteSpace(item.Text) && item.Text.Length <= 300)?.Text);
                    _contentSource = "Conteúdo remoto";
                    StateHasChanged();
                });
        }
        catch (Exception) { /* API offline: falas locais e jogo continuam funcionando. */ }
    }

    // --- Diálogo via IA de NPCs: eventos -> agendador com budget -> decisões ---
    // O cérebro da Guardiã (GuardianBrain) decide sobre um snapshot do mundo; a UI é
    // casca que aplica os comandos. A WebLLM e a API são produtores externos de
    // respostas: chegam como ReplyArrived pela fila, nunca bloqueiam o tick.

    private static long NowMs() => DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

    private WorldSnapshot Snapshot() => new(_posX, _posZ, _near, _nearWanderer, _view is not null, _aiState == "ready", NowMs());

    private void Dispatch(GameEvent e)
    {
        _npc.Submit(e);
        RunNpcTick();
    }

    // Batida do agendador: o que não coube no orçamento do tick anterior retoma aqui
    // (chamado também pelo MoveTick do loop de jogo, a 5 Hz).
    private void RunNpcTick()
    {
        if (_npc.PendingEvents == 0) { return; }
        foreach (var decision in _npc.Tick(Snapshot()))
        {
            ApplyDecision(decision);
        }
    }

    private void ApplyDecision(NpcDecision decision)
    {
        if (decision.View is not null)
        {
            _view = decision.View.CurrentLine >= 0 ? decision.View : null;
        }
        foreach (var command in decision.Commands)
        {
            switch (command)
            {
                case ResolveAnimationMark mark:
                    _ = ResolveAnimationMarkAsync(mark);
                    break;
                case OpenDialog:
                    _ = SetFrozen(true);
                    break;
                case Ultima.Npc.CloseDialog:
                    _view = null;
                    _ = JS.InvokeVoidAsync("game.voice.stopDictation");
                    _ = SetFrozen(false);
                    break;
                case ShowLine(int index):
                    _ = SpeakLineAsync(decision.View!.Lines[index]);
                    break;
                case SetReply(int index, var text, _):
                    _ = SpeakLineAsync(new DialogLine(decision.View!.Lines[index].Speaker, text));
                    // t50: funil único do registro de conversas — chega aqui todo turno com
                    // resposta (roteiro, chat da Guardiã ou IA local); a pergunta do jogador
                    // é a linha anterior do mesmo diálogo. O módulo JS sanitiza e enfileira.
                    try
                    {
                        var dlg = decision.View;
                        var playerLine = index > 0 && dlg.Lines[index - 1].Speaker == "Você"
                            ? dlg.Lines[index - 1].Text : string.Empty;
                        var ms = _turnStartedMs > 0 ? (long)(NowMs() - _turnStartedMs) : 0;
                        _ = Dialogs.RecordAsync(dlg.Speaker, playerLine, text, dlg.ReplySource, ms);
                    }
                    catch (JSException) { /* registro é opcional: nunca atrapalha o diálogo */ }
                    break;
            }
        }
        StateHasChanged();
    }

    private async Task ResolveAnimationMarkAsync(ResolveAnimationMark mark)
    {
        if (mark.Name == "hit" && mark.Payload == "collect" &&
            mark.Target.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            try
            {
                var target = System.Text.Json.JsonSerializer.Deserialize<AnimationCollectionTarget>(
                    mark.Target, AnimationTargetJson.Default.AnimationCollectionTarget);
                if (target?.Resource is not null) await BackpackState.CollectAsync(target.Resource, target.Point);
            }
            catch (System.Text.Json.JsonException) { }
        }
        else if (mark.Name == "sound")
        {
            await JS.InvokeVoidAsync("game.animationSound", mark.Payload);
        }
    }

    private Task OnInteractAsync()
    {
        if (_view is null && !_near && !_nearWanderer && _nearObject is { } label)
        {
            Snackbar.Info($"Você examinou: {label}");
        }
        else
        {
            Dispatch(new PlayerInteracted(NowMs()));
        }
        return Task.CompletedTask;
    }

    private SceneryProposal? _proposal;
    private string? _proposalReply;
    private bool _journalOpen;
    private bool _windowContrast;
    private readonly WindowState _conversationState = new();
    private readonly WindowState _journalState = new();

    private WindowState ConversationState()
    {
        var view = _view!;
        var line = view.Lines[view.CurrentLine];
        var values = _conversationState.Text;
        values["speaker"] = line.Speaker;
        values["line"] = line.Text;
        values["source"] = !view.Thinking && !string.IsNullOrEmpty(view.ReplySource) && line.Speaker != "Você"
            ? "✦ origem da resposta: " + view.ReplySource : "";
        values["variation"] = line.Text == _proposalReply ? _proposal?.Label ?? "" : "";
        values["draft"] = _dialogDraft;
        values["dictation"] = _dictating ? "Parar ditado" : "Ditar";
        values["speechError"] = _speechError;
        values["advance"] = view.CurrentLine + 1 < view.Lines.Count ? "Continuar · E/A" : "Encerrar · E/A";
        return _conversationState;
    }

    private void EditWindow((string Key, string Value) edit)
    {
        if (edit.Key == "draft") _dialogDraft = edit.Value;
    }

    private void OpenJournal()
    {
        _panelOpen = false;
        _journalOpen = true;
        var entries = Dialogs.RecentEntries();
        _journalState.Lists["entries"] = entries;
        _journalState.Text["empty"] = entries.Count == 0 ? "Suas conversas com personagens aparecem aqui." : "";
        _journalState.Text["hasEntries"] = entries.Count == 0 ? "" : "true";
        UpdateWindowThemeLabel();
    }

    private void UpdateWindowThemeLabel() =>
        _journalState.Text["theme"] = _windowContrast ? "Tema padrão" : "Mais contraste";

    private Task DispatchWindowActionAsync(string action)
    {
        switch (action)
        {
            case "advance": return AdvanceAsync();
            case "speak": return SubmitDialogAsync();
            case "vary" when _proposal is { } proposal:
                _proposal = null;
                return VaryAsync(proposal.Model, proposal.Detail, proposal.Seed);
            case "dictate": return ToggleDictationAsync();
            case "close":
                if (_view is not null) CloseDialog();
                else _journalOpen = false;
                break;
            case "theme":
                _windowContrast = !_windowContrast;
                UpdateWindowThemeLabel();
                break;
        }
        return Task.CompletedTask;
    }

    private Task AdvanceAsync() { Dispatch(new PlayerInteracted(NowMs())); return Task.CompletedTask; }

    private async Task SubmitDialogAsync()
    {
        var text = _dialogDraft.Trim();
        if (_view is null || _view.Thinking || text.Length == 0) return;
        if (text.Length > 300) text = text[..300];
        _dialogDraft = string.Empty;
        _speechError = string.Empty;
        _turnStartedMs = NowMs();   // t50: base do tempo de resposta do turno registrado
        _ = JS.InvokeVoidAsync("game.characterDialogueLine", "Você", text.Length);
        Dispatch(new PlayerSpoke(NowMs(), text));
        _proposal = null;
        _proposalReply = null;
        if (SceneryProposal.ForRequest(text, Random.Shared.Next()) is { } proposal)
        {
            var speaker = _view.Speaker;
            var proposalSource = "oficina do mundo · versão procedural";
            if (_aiState == "ready")
            {
                try
                {
                    var choice = await JS.InvokeAsync<double[]?>("game.ai.proposeScenery", TimeSpan.FromSeconds(20), proposal.Model, text);
                    if (choice is [var seed, var detail] && seed >= 0 && seed <= int.MaxValue && seed == Math.Truncate(seed)
                        && detail is >= 0.5 and <= 1.6)
                    {
                        proposal = proposal with { Seed = (int)seed, Detail = detail };
                        proposalSource = "GPU do jogador · oficina do mundo";
                    }
                }
                catch (JSException) { /* a proposta local segue disponível */ }
                catch (OperationCanceledException) { /* tempo limite do produtor */ }
            }
            if (_view?.Speaker != speaker || !_view.Thinking) return;
            _proposal = proposal;
            _proposalReply = $"Posso preparar outra versão para você. Use “{proposal.Label}” para experimentar.";
            Dispatch(new ReplyArrived(NowMs(), _proposalReply, proposalSource));
            return;
        }
        // Produtores caros (WebLLM na GPU, API do jogo, fallback local) correm fora do
        // tick; a resposta vira evento e o cérebro a aplica em um tick futuro. Os
        // produtores atuais têm a persona da Guardiã: o Andarilho responde com falas
        // locais próprias até existir um produtor para ele.
        var (reply, source) = _view.Speaker == "Andarilho"
            ? ("Hm… sigo pensando nisso enquanto caminho. Sobre o jardim, pergunte à Guardiã; das trilhas, eu conto.", "falas locais do andarilho")
            : await AskGuardianAsync(text);
        Dispatch(new ReplyArrived(NowMs(), reply, source));
    }

    // A Guardiã responde pela API do jogo (IA quando configurada, regras caso contrário);
    // sem rede, cai numa resposta local para o diálogo nunca travar. Cada origem é marcada.
    private async Task<(string Reply, string Source)> AskGuardianAsync(string text)
    {
        // Cadeia de resposta local: GPU (WebGPU/WebLLM) → CPU (wllama WASM) → servidor (regras).
        // O motor efetivamente usado aparece na origem marcada de cada resposta.
        if (_aiState == "ready")
        {
            try
            {
                var local = await JS.InvokeAsync<string?>("game.ai.ask", TimeSpan.FromSeconds(60), text, _playerName ?? string.Empty);
                if (!string.IsNullOrWhiteSpace(local))
                {
                    return (local!.Length > 500 ? local[..500] : local, "GPU do jogador (modelo local)");
                }
            }
            catch (Exception ex) { Console.WriteLine($"[ia] local falhou: {ex.GetType().Name}: {ex.Message}"); }
        }
        if (_aiCpuState == "ready")
        {
            try
            {
                var localCpu = await JS.InvokeAsync<string?>("game.aiCpu.ask", TimeSpan.FromSeconds(120), text, _playerName ?? string.Empty);
                if (!string.IsNullOrWhiteSpace(localCpu))
                {
                    return (localCpu!.Length > 500 ? localCpu[..500] : localCpu, "CPU do jogador (modelo local WASM)");
                }
            }
            catch (Exception ex) { Console.WriteLine($"[ia-cpu] local falhou: {ex.GetType().Name}: {ex.Message}"); }
        }
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            // JSON montado/lido sem reflexão: imune ao trimming do build Release.
            var payload = new Dictionary<string, string>
            {
                ["message"] = text,
                ["session"] = _chatSession,
                ["player"] = _playerName ?? string.Empty
            };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            using var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            using var res = await Http.PostAsync($"{ContentApi}/v1/npcs/guardia/chat", content, cts.Token);
            var raw = await res.Content.ReadAsStringAsync(cts.Token);
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            if (doc.RootElement.TryGetProperty("reply", out var r) && r.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var reply = r.GetString();
                if (!string.IsNullOrWhiteSpace(reply))
                {
                    var origin = "servidor do jogo";
                    if (doc.RootElement.TryGetProperty("source", out var s) && s.ValueKind == System.Text.Json.JsonValueKind.String)
                    {
                        var src = s.GetString();
                        origin = src == "rules" ? "servidor · regras" : $"servidor · {src}";
                    }
                    return (reply!.Length > 500 ? reply[..500] : reply, origin);
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"[npc] chat falhou: {ex.GetType().Name}: {ex.Message}"); }
        return ("Os ventos do jardim estão agitados e mal ouço você. Tente de novo em instantes, caminhante.", "falas locais do jogo (sem rede)");
    }

    private void CloseDialog()
    {
        if (_view is null) return;
        _npc.Submit(new DialogClosedByPlayer(NowMs()));   // sincroniza o cérebro sem tick extra
        _view = null;
        _proposal = null;
        _proposalReply = null;
        _ = JS.InvokeVoidAsync("game.voice.stopDictation");
        _ = SetFrozen(false);
        StateHasChanged();
    }

    private async Task SpeakLineAsync(DialogLine line)
    {
        await JS.InvokeVoidAsync("game.characterDialogueLine", line.Speaker, line.Text.Length);
        if (_speakEnabled) await JS.InvokeVoidAsync("game.voice.speak", line.Text, line.Speaker);
    }

    private async Task OnSpeakToggled(bool enabled)
    {
        _speakEnabled = enabled;
        await JS.InvokeVoidAsync("game.voice.setSpeakPref", _speakEnabled);
        if (_speakEnabled && _view is not null) await SpeakLineAsync(_view.Lines[_view.CurrentLine]);
    }

    private async Task ToggleDictationAsync()
    {
        _speechError = string.Empty;
        if (_dictating) await JS.InvokeVoidAsync("game.voice.stopDictation");
        else await JS.InvokeVoidAsync("game.voice.startDictation");
    }

    private async Task OnMicToggled(bool enabled)
    {
        if (enabled) await JS.InvokeVoidAsync("game.voice.startMic");
        else await JS.InvokeVoidAsync("game.voice.stopMic");
    }

    private async Task OnPlayerNameChanged(string value)
    {
        _playerName = value;
        await JS.InvokeVoidAsync("game.net.setName", _playerName);
    }

    private sealed record InviteInfo(string? Room);

    private async Task CopyInviteAsync()
    {
        var info = await JS.InvokeAsync<InviteInfo?>("game.net.info");
        var room = info?.Room ?? "jardim";
        var link = Invite.Link(Navigation.Uri, room);
        try
        {
            await JS.InvokeVoidAsync("game.browser.copy", link);
            _netStatus = $"Convite copiado. Abra o link em outra aba ou dispositivo: {room}";
        }
        catch (JSException) { _netStatus = "Copie o link: " + link; }
    }

    private async Task SendChatAsync()
    {
        var text = _chatDraft.Trim();
        if (text.Length == 0) return;
        _chatDraft = string.Empty;
        AddChat("Você", text);
        await JS.InvokeVoidAsync("game.net.sendChat", text);
    }

    private void AddChat(string from, string text)
    {
        _chat.Add(new ChatMessage(from.Length > 40 ? from[..40] : from, text.Length > 300 ? text[..300] : text));
        if (_chat.Count > 30) _chat.RemoveAt(0);
    }

    private async Task Restart()
    {
        if (_view is not null)
        {
            _npc.Submit(new DialogClosedByPlayer(NowMs()));
            _view = null;
            await SetFrozen(false);
        }
        await JS.InvokeVoidAsync("game.resetPlayer");
    }

    private Task SetFrozen(bool frozen) => JS.InvokeVoidAsync("game.setFrozen", frozen, _view?.Speaker).AsTask();

    public void Dispose()
    {
        _browserLifetime.Cancel();
        _browserLifetime.Dispose();
        Dialogs.Changed -= ShowDialogCount;
        Live.Status -= ShowLiveStatus;
        Live.Chat -= ShowLiveChat;
        Live.VolumeTunnelsChanged -= ShowVolumeTunnels;
        BackpackState.Changed -= ShowBackpack;
        BackpackState.Status -= ShowBackpackStatus;
        WorkshopService.Status -= ShowWorkshopStatus;
        WorkshopService.BuildAssetsChanged -= ShowBuildAssets;
        _bridge?.Dispose();
        _modelsRef?.Dispose();
    }
}
