    // --- O que a IA está fazendo agora, resumido para o cartão de status (mesmo recolhido) ---
    // Só aparece quando algo acontece ou dá errado; "off", "checking", "unsupported" e "ready"
    // ficam só no painel de IA. Os detalhes e o "Tentar de novo" continuam no painel.
    private sealed record AiActivity(string Label, double Progress, bool ShowProgress, Sufficit.Blazor.UI.Components.SUITone Tone);

    private AiActivity? CurrentAiActivity()
        => AiActivityOf(_aiState, _aiProgress, "GPU") ?? AiActivityOf(_aiCpuState, _aiCpuProgress, "CPU");

    private static AiActivity? AiActivityOf(string state, double progress, string engine)
    {
        var pct = (int)Math.Round(progress * 100);
        return state switch
        {
            "model" or "downloading" => new AiActivity($"Baixando IA ({engine}) · {pct}%", progress, true, SUITone.Info),
            "loading" or "compiling" => new AiActivity($"Preparando IA ({engine})…", progress, true, SUITone.Info),
            "thinking" => new AiActivity($"Guardiã pensando ({engine})…", progress, false, SUITone.Info),
            "stalled" => new AiActivity($"IA travada em {pct}% ({engine})", progress, true, SUITone.Warning),
            "error" => new AiActivity($"Erro na IA ({engine})", progress, false, SUITone.Danger),
            _ => null,
        };
    }

    // --- Avisos vindos do servidor são transitórios: somem sozinhos depois do tempo de leitura ---
    // (6 s + 12 caracteres por segundo, entre 8 e 25 s)
    private static TimeSpan AnnouncementTime(string text) => TimeSpan.FromSeconds(Math.Clamp(6 + text.Length / 12, 8, 25));
    private void ShowAnnouncement(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        _ = InvokeAsync(async () =>
        {
            var version = ++_announcementVersion;
            _announcement = text;
            StateHasChanged();
            try { await Task.Delay(AnnouncementTime(text), _browserLifetime.Token); }
            catch (Exception e) when (e is OperationCanceledException or ObjectDisposedException) { return; }
            if (version != _announcementVersion) return;   // um aviso mais novo assumiu o lugar
            _announcement = null;
            StateHasChanged();
        });
    }
    private Sufficit.Blazor.UI.Components.SUITone NetTone() => _netStatus.Contains("Conectad", StringComparison.OrdinalIgnoreCase) ? Sufficit.Blazor.UI.Components.SUITone.Success
        : _netStatus.Contains("Conectando", StringComparison.OrdinalIgnoreCase) ? Sufficit.Blazor.UI.Components.SUITone.Info
        : _netStatus.Contains("falha", StringComparison.OrdinalIgnoreCase) || _netStatus.Contains("erro", StringComparison.OrdinalIgnoreCase) ? Sufficit.Blazor.UI.Components.SUITone.Danger
        : Sufficit.Blazor.UI.Components.SUITone.Neutral;
    private void ToggleStatus() => _statusExpanded = !_statusExpanded;
