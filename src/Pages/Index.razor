@page "/"
@implements IDisposable
@using Ultima.Npc
@using Sufficit.Blazor.UI.Components
@using Sufficit.Blazor.UI.Services
@inject IJSRuntime JS
@inject HttpClient Http
@inject Ultima.Models.ModelLoader Models
@inject ISUISnackbar Snackbar

@* Interface do jogo sobre a base Sufficit.Blazor.UI (SUI).
   Painéis flutuam sobre o canvas 3D; nada de barras fixas de texto.
   Os elementos com id (game-canvas, sticks, botões A/B) são lidos pelo JS
   do jogo e nunca podem ser renderizados condicionalmente. *@
<div class="game-shell ultima-theme@((_menuOpen ? " ultima-menu-open" : "") + (_view is not null ? " ultima-dialog-open" : ""))">
    <main class="viewport">
        <canvas id="game-canvas" tabindex="0" aria-label="Mundo 3D. WASD, setas, joystick ou controles de toque movem; E/A conversa."></canvas>

        @if (!string.IsNullOrEmpty(_announcement))
        {
            <div class="ultima-toast ultima-announce" role="note">@_announcement</div>
        }

        @if ((_near || _nearWanderer) && _view is null)
        {
            <div class="ultima-toast ultima-hint" role="status">
                Perto @(_near ? "da Guardiã" : "do Andarilho") —
                <span class="hint-kb">pressione <kbd>E</kbd></span>
                <span class="hint-pad">pressione <kbd>A</kbd> no controle</span>
                <span class="hint-touch">toque no botão <kbd>A</kbd></span>
                para conversar
            </div>
        }


        @if (_chat.Count > 0)
        {
            <section class="ultima-chat-log" aria-label="Mensagens dos jogadores" aria-live="polite">
                @foreach (var message in _chat.TakeLast(4))
                {
                    <p><strong>@message.From:</strong> @message.Text</p>
                }
            </section>
        }

        <form class="ultima-chat-compose" @onsubmit="SendChatAsync" @onsubmit:preventDefault="true">
            <label class="sr-only" for="network-chat-input">Mensagem para outros jogadores</label>
            <SUITextField TValue="string" Id="network-chat-input" Placeholder="Mensagem para outros jogadores…"
                          MaxLength="300" Immediate="true" @bind-Value="_chatDraft" />
            <SUIButton ButtonTypeValue="SUIButtonType.Submit" SizeValue="SUISize.Small" StartIcon="send"
                       aria-label="Enviar mensagem">Enviar</SUIButton>
        </form>

        @if (_menuOpen)
        {
            <button type="button" id="ultima-menu-backdrop" class="ultima-menu-backdrop" aria-label="Fechar menu"
                    @onclick="ToggleMenu"></button>
        }
        <button type="button" id="ultima-menu-fab" class="ultima-menu-fab" aria-label="@(_menuOpen ? "Fechar menu" : "Abrir menu")"
                aria-expanded="@_menuOpen.ToString().ToLower()" @onclick="ToggleMenu">☰</button>

        <div class="ultima-menu">
            <div class="ultima-menu__head">
                <strong>Menu</strong>
                <button type="button" class="ultima-menu__close" aria-label="Fechar menu" @onclick="ToggleMenu">✕</button>
            </div>

        <aside class="ultima-status" aria-label="Status do jogo">
            <SUICard Elevation="2" Class="ultima-card--glass">
                <SUICardHeader Title="@StatusTitle()" Description="@StatusSummary()">
                    <MetaContent>
                        <SUIStatusBadge ToneValue="@NetTone()">@NetLabel()</SUIStatusBadge>
                    </MetaContent>
                </SUICardHeader>
                @if (_statusExpanded)
                {
                    <SUICardContent>
                        <SUIStack Spacing="1">
                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                pos (@_posX.ToString("F1"), @_posZ.ToString("F1")) · alt @_posY.ToString("F1") · @_renderer
                            </SUIText>
                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">IA: @ActiveEngine()</SUIText>
                            @if (_devHud)
                            {
                                <SUIText Typo="SUITypo.mono" Color="SUIColor.Secondary">FPS: @_fps.ToString("0") · @_contentSource · build @BuildId</SUIText>
                                <SUIText Typo="SUITypo.mono" Color="SUIColor.Secondary">diálogos na fila: <span id="ultima-dialog-queue-count">0</span></SUIText>
                            }
                            <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Text" OnClick="ToggleStatus">Ocultar detalhes</SUIButton>
                        </SUIStack>
                    </SUICardContent>
                }
            </SUICard>
            @if (!_statusExpanded)
            {
                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Soft" OnClick="ToggleStatus" Class="ultima-status__more">detalhes</SUIButton>
            }
        </aside>

        <div class="ultima-panel-toggle">
            <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Soft" StartIcon="menu" OnClick="TogglePanel"
                       aria-expanded="@(_panelOpen ? "true" : "false")"
                       aria-label="@(_panelOpen ? "Fechar painel do jogo" : "Abrir painel do jogo")">@(_panelOpen ? "Fechar" : "Painel")</SUIButton>
        </div>

        @if (_panelOpen)
        {
            <aside class="ultima-panel" aria-label="Painel do jogo">
                <SUICard Elevation="3" Class="ultima-card--glass">
                    <SUICardContent>
                        <SUIStack Spacing="2">

                            <SUIExpansionPanel Title="Oficina do mundo" StartIcon="settings"
                                               Expanded="_workshopOpen" ExpandedChanged="OnWorkshopToggled">
                                <SUIStack Spacing="1">

                                    @if (!string.IsNullOrEmpty(_workshopStatus))
                                    {
                                        <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary" role="status" aria-live="polite">@_workshopStatus</SUIText>
                                    }

                                    <SUIExpansionPanel Title="Variações do cenário" StartIcon="tune">
                                        <SUIStack Spacing="2">
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                                Árvores, pedras e grama se remodelam na hora, pelo mesmo motor paramétrico do mundo.
                                            </SUIText>
                                            <SUIStack Row="true" Spacing="1" Wrap="true">
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="@(() => VaryAsync("tree.pine", null))">Árvores novas</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="@(() => VaryAsync("tree.pine", 1.6))">Densas</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="@(() => VaryAsync("tree.pine", 0.6))">Jovens</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="@(() => VaryAsync("rock.boulder", null))">Pedras novas</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="@(() => VaryAsync("scenery.grass", 1.4))">Grama exuberante</SUIButton>
                                            </SUIStack>
                                        </SUIStack>
                                    </SUIExpansionPanel>

                                    <SUIExpansionPanel Title="Criar modelo" StartIcon="science">
                                        <SUIStack Spacing="2">
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                                Descreva e o servidor gera um GLB (SHA-256 verificado) plantado no mundo compartilhado.
                                            </SUIText>
                                            <SUIStack Row="true" Spacing="1" Wrap="true" AlignItems="end">
                                                <SUITextField TValue="string" Id="workshop-prompt" Label="O que criar" Placeholder="ex.: cristal encantado azul"
                                                              MaxLength="120" Immediate="true" @bind-Value="_promptDraft" />
                                                <SUIButton SizeValue="SUISize.Small" StartIcon="plus" OnClick="GenerateAsync">Gerar</SUIButton>
                                            </SUIStack>
                                        </SUIStack>
                                    </SUIExpansionPanel>

                                    <SUIExpansionPanel Title="Enviar modelo" StartIcon="upload">
                                        <SUIStack Spacing="2">
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                                Até 2 MB e 30 mil triângulos; validado no servidor e publicado para todos os jogadores.
                                            </SUIText>
                                            @* Botão da UI + InputFile padrão do Blazor escondido (a versão fixada da Sufficit.Blazor.UI
                                               ainda não tem componente de arquivo; quando subir, vira <SUIFileUpload>). *@
                                            <InputFile Id="workshop-file" class="sr-only" tabindex="-1" aria-hidden="true"
                                                       Accept=".glb,model/gltf-binary" OnChange="OnWorkshopFileInputChanged" />
                                            <SUIStack Row="true" Spacing="1" AlignItems="center" Wrap="true">
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="upload"
                                                           OnClick="PickWorkshopFileAsync">Escolher .glb</SUIButton>
                                                <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary" role="status">
                                                    @(string.IsNullOrEmpty(_workshopFileName) ? "Nenhum arquivo escolhido." : "Enviando " + _workshopFileName + "…")
                                                </SUIText>
                                            </SUIStack>
                                            <SUINumericField TValue="double" Id="workshop-scale" Label="Tamanho em metros" HelperText="Maior dimensão do modelo."
                                                             Min="0.05" Max="12" Step="0.05" Value="_uploadScale" ValueChanged="OnUploadScaleChanged" />
                                        </SUIStack>
                                    </SUIExpansionPanel>

                                    <SUIExpansionPanel Title="Esculpir o terreno" StartIcon="edit">
                                        <SUIStack Spacing="2">
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                                Clique no terreno para aplicar. Cada pincelada fica no mundo de todos.
                                            </SUIText>
                                            <SUINumericField TValue="double" Id="build-radius" Label="Raio do pincel em metros"
                                                             Min="2" Max="8" Step="0.5" Value="_brushRadius" ValueChanged="OnBrushRadiusChanged" />
                                            <SUIStack Row="true" Spacing="1" Wrap="true">
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="plus" OnClick="@(() => BuildModeAsync("raise"))">Levantar</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="delete" OnClick="@(() => BuildModeAsync("dig"))">Cavar</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="arrow-right" Title="Dois cliques: início e fim" OnClick="@(() => BuildModeAsync("passage"))">Passagem</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="inbox" Title="Cava uma gruta com paredão de rocha" OnClick="@(() => BuildModeAsync("cave"))">Gruta</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="palette" OnClick="@(() => BuildModeAsync("paint"))">Pintar</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="close" OnClick="@(() => BuildModeAsync("off"))">Sair do modo</SUIButton>
                                            </SUIStack>
                                            <SUISelect TValue="string" Id="paint-mat" Label="Material da pintura" Value="_paintMaterial" ValueChanged="OnPaintMaterialChanged">
                                                <SUISelectItem Value='@("sand")'>areia</SUISelectItem>
                                                <SUISelectItem Value='@("grass")'>grama</SUISelectItem>
                                                <SUISelectItem Value='@("dirt")'>terra</SUISelectItem>
                                                <SUISelectItem Value='@("rock")'>rocha</SUISelectItem>
                                                <SUISelectItem Value='@("snow")'>neve</SUISelectItem>
                                                <SUISelectItem Value='@("water")'>água</SUISelectItem>
                                            </SUISelect>
                                        </SUIStack>
                                    </SUIExpansionPanel>

                                    <SUIExpansionPanel Title="Construir" StartIcon="plus">
                                        <SUIStack Spacing="2">
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                                Plante modelos no terreno; a posição fica salva para todos os jogadores.
                                            </SUIText>
                                            <SUIStack Row="true" Spacing="1" Wrap="true" AlignItems="end">
                                                <SUISelect TValue="string" Id="build-asset" Label="Modelo" Value="_buildAsset" ValueChanged="OnBuildAssetChanged"
                                                           Placeholder="Nenhum modelo carregado" Disabled="@(_buildAssets.Count == 0)"
                                                           HelperText="@(_buildAssets.Count == 0 ? "Os modelos carregados no mundo aparecem aqui." : null)">
                                                    @foreach (var id in _buildAssets)
                                                    {
                                                        <SUISelectItem Value='@id'>@id</SUISelectItem>
                                                    }
                                                </SUISelect>
                                                <SUIIconButton Icon="refresh" Title="Recarregar a lista de modelos" OnClick="RefreshBuildAssetsAsync" />
                                            </SUIStack>
                                            <SUIStack Row="true" Spacing="1" Wrap="true">
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="plus" OnClick="@(() => BuildModeAsync("place", new { asset = _buildAsset }))">Plantar</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="trash" OnClick="@(() => BuildModeAsync("remove"))">Remover</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="close" OnClick="@(() => BuildModeAsync("off"))">Sair do modo</SUIButton>
                                            </SUIStack>
                                        </SUIStack>
                                    </SUIExpansionPanel>

                                    <SUIExpansionPanel Title="Gráficos" StartIcon="settings">
                                        <SUIStack Spacing="2">
                                            <SUIStack Row="true" Spacing="1" Wrap="true">
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="@(_gfxStyle == "padrao" ? SUIVariant.Soft : SUIVariant.Outlined)"
                                                           aria-pressed="@(_gfxStyle == "padrao" ? "true" : "false")" OnClick="@(() => SetGfxAsync("padrao"))">Padrão (leve)</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="@(_gfxStyle == "pbr" ? SUIVariant.Soft : SUIVariant.Outlined)"
                                                           aria-pressed="@(_gfxStyle == "pbr" ? "true" : "false")" OnClick="@(() => SetGfxAsync("pbr"))">PBR + IBL</SUIButton>
                                            </SUIStack>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@(_gfxDirty ? "Recarregue para aplicar." : "Ativo: " + (_gfxStyle == "pbr" ? "PBR + IBL" : "padrão") + ".")</SUIText>
                                            @if (_gfxDirty)
                                            {
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="restart" OnClick="ReloadPage">Recarregar para aplicar</SUIButton>
                                            }
                                        </SUIStack>
                                    </SUIExpansionPanel>

                                    <SUIExpansionPanel Title="Estilo do mundo" StartIcon="palette">
                                        <SUIStack Spacing="2">
                                            <SUIStack Row="true" Spacing="1" Wrap="true">
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="@(_sceneryStyle == "procedural" ? SUIVariant.Soft : SUIVariant.Outlined)"
                                                           aria-pressed="@(_sceneryStyle == "procedural" ? "true" : "false")" OnClick="@(() => SetSceneryAsync("procedural"))">Procedural (padrão)</SUIButton>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="@(_sceneryStyle == "lowpoly" ? SUIVariant.Soft : SUIVariant.Outlined)"
                                                           aria-pressed="@(_sceneryStyle == "lowpoly" ? "true" : "false")" OnClick="@(() => SetSceneryAsync("lowpoly"))">Low-poly CC0</SUIButton>
                                            </SUIStack>
                                            @if (_sceneryDirty)
                                            {
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="restart" OnClick="ReloadPage">Recarregar para aplicar</SUIButton>
                                            }
                                        </SUIStack>
                                    </SUIExpansionPanel>

                                </SUIStack>
                            </SUIExpansionPanel>

                            <SUIExpansionPanel Title="Multiplayer e voz">
                                <SUIStack Spacing="2">
                                    <SUIStack Row="true" Spacing="1" Wrap="true">
                                        <SUIStatusBadge ToneValue="@NetTone()">@_netStatus</SUIStatusBadge>
                                    </SUIStack>
                                    <SUITextField TValue="string" Id="player-name" Label="Seu nome" MaxLength="40" Immediate="true"
                                                  Value="_playerName" ValueChanged="OnPlayerNameChanged" />
                                    <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="copy"
                                               OnClick="CopyInviteAsync">Copiar convite</SUIButton>
                                    <SUISwitch Label="Transmitir minha voz" Value="_micEnabled" ValueChanged="OnMicToggled" />
                                    <SUIProgressLinear Value="@Math.Round(_micLevel * 100)" Rounded="true" ColorValue="SUIColor.Success"
                                                       AriaLabel="Nível do microfone" />
                                    <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_micStatus</SUIText>
                                    <SUISwitch Label="Ler falas em voz alta" Value="_speakEnabled" ValueChanged="OnSpeakToggled" />
                                </SUIStack>
                            </SUIExpansionPanel>

                            <SUIExpansionPanel Title="IA da Guardiã (GPU)">
                                <SUIStack Spacing="2">
                                    @switch (_aiState)
                                    {
                                        case "checking":
                                        case "unsupported":
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiDetail</SUIText>
                                            break;
                                        case "ready":
                                            <SUIStack Row="true" Spacing="2" AlignItems="center" Wrap="true">
                                                <SUIStatusBadge ToneValue="SUITone.Success" Icon="check">IA local pronta</SUIStatusBadge>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="DisableAiAsync">Desligar</SUIButton>
                                            </SUIStack>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiDetail</SUIText>
                                            break;
                                        case "thinking":
                                            <SUIStatusBadge ToneValue="SUITone.Info">Pensando…</SUIStatusBadge>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiDetail</SUIText>
                                            break;
                                        case "model":
                                        case "downloading":
                                        case "compiling":
                                        case "stalled":
                                            <SUIProgressLinear Value="@Math.Round(_aiProgress * 100)" Rounded="true" AriaLabel="Progresso do modelo de IA" />
                                            <SUIText Typo="SUITypo.caption">@((int)(_aiProgress * 100))% · @_aiDetail</SUIText>
                                            @if (_aiState == "stalled")
                                            {
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="RetryAiAsync">Tentar de novo</SUIButton>
                                            }
                                            break;
                                        case "error":
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Error">@_aiDetail</SUIText>
                                            <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="RetryAiAsync">Tentar de novo</SUIButton>
                                            break;
                                        default:
                                            <SUIButton SizeValue="SUISize.Small" OnClick="EnableAiAsync">Ativar IA na minha GPU</SUIButton>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">Roda no seu navegador, sem enviar a conversa. @_aiDetail</SUIText>
                                            break;
                                    }
                                </SUIStack>
                            </SUIExpansionPanel>

                            <SUIExpansionPanel Title="IA na CPU (sem placa de vídeo)">
                                <SUIStack Spacing="2">
                                    <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">Motor ativo: @ActiveEngine()</SUIText>
                                    @if (_aiCpuState != "ready")
                                    {
                                        <div class="ultima-models" role="group" aria-label="Escolher modelo da IA na CPU">
                                            @foreach (var kv in AiCpuModels)
                                            {
                                                var selected = kv.Key == _aiCpuModel;
                                                <SUIButton SizeValue="SUISize.Small" FullWidth="true"
                                                           VariantValue="@(selected ? SUIVariant.Soft : SUIVariant.Outlined)"
                                                           Class="@(selected ? "ultima-model-btn ultima-model-btn--on" : "ultima-model-btn")"
                                                           OnClick="@(() => SelectAiCpuModelAsync(kv.Key))"
                                                           aria-pressed="@(selected ? "true" : "false")">
                                                    @kv.Value.Label · @kv.Value.Why
                                                </SUIButton>
                                            }
                                        </div>
                                    }
                                    @switch (_aiCpuState)
                                    {
                                        case "ready":
                                            <SUIStack Row="true" Spacing="2" AlignItems="center" Wrap="true">
                                                <SUIStatusBadge ToneValue="SUITone.Success" Icon="check">IA na CPU pronta</SUIStatusBadge>
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="DisableAiCpuAsync">Desligar</SUIButton>
                                            </SUIStack>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiCpuDetail</SUIText>
                                            break;
                                        case "thinking":
                                            <SUIStatusBadge ToneValue="SUITone.Info">Pensando…</SUIStatusBadge>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiCpuDetail</SUIText>
                                            break;
                                        case "model":
                                        case "downloading":
                                        case "loading":
                                        case "stalled":
                                            <SUIProgressLinear Value="@Math.Round(_aiCpuProgress * 100)" Rounded="true" AriaLabel="Progresso do modelo de IA na CPU" />
                                            <SUIText Typo="SUITypo.caption">@((int)(_aiCpuProgress * 100))% · @_aiCpuDetail</SUIText>
                                            @if (_aiCpuState == "stalled")
                                            {
                                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="RetryAiCpuAsync">Tentar de novo</SUIButton>
                                            }
                                            break;
                                        case "error":
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Error">@_aiCpuDetail</SUIText>
                                            <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" OnClick="RetryAiCpuAsync">Tentar de novo</SUIButton>
                                            break;
                                        default:
                                            <SUIButton SizeValue="SUISize.Small" OnClick="EnableAiCpuAsync">Ativar IA na minha CPU</SUIButton>
                                            <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">@_aiCpuDetail</SUIText>
                                            break;
                                    }
                                </SUIStack>
                            </SUIExpansionPanel>

                            <SUIExpansionPanel Title="Controles e ajuda">
                                <SUIStack Spacing="2">
                                    <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                        teclado: <kbd>WASD</kbd>/<kbd>↑↓←→</kbd> andar · <kbd>E</kbd> conversa · <kbd>Esc</kbd> fecha · mouse gira a câmera
                                    </SUIText>
                                    <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">
                                        controle: <kbd>LS</kbd> mover · <kbd>RS</kbd> câmera · botão <kbd>Ⓐ</kbd>/<kbd>✕</kbd> conversar · celular: analógicos na tela
                                    </SUIText>
                                    <SUISwitch Label="Informações de desenvolvimento (FPS, fonte do conteúdo)" Value="_devHud" ValueChanged="OnDevToggled" />
                                    <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="restart" OnClick="Restart">Voltar ao início da trilha</SUIButton>
                                </SUIStack>
                            </SUIExpansionPanel>

                        </SUIStack>
                    </SUICardContent>
                </SUICard>
            </aside>
        }


        </div><!-- /.ultima-menu -->

        <div class="touch-controls" aria-label="Controles táteis">
            <div id="move-stick" class="touch-stick" aria-label="Analógico para andar"><span id="move-thumb"></span><small>ANDAR</small></div>
            <div class="touch-right-controls">
                <div id="look-stick" class="touch-stick look-stick" aria-label="Analógico para câmera"><span id="look-thumb"></span><small>CÂMERA</small></div>
                <button id="touch-cancel" type="button" aria-label="Fechar diálogo">B</button>
                <button id="touch-action" type="button" aria-label="Conversar com a Guardiã">A</button>
            </div>
        </div>

        @if (_view is not null)
        {
            <section class="ultima-dialog" role="dialog" aria-modal="false" aria-label="Conversa com a Guardiã">
                <SUICard Elevation="3" Class="ultima-card--glass">
                    <SUICardContent>
                        <SUIStack Spacing="2">
                            <p class="ultima-dialog__speaker">@_view.Lines[_view.CurrentLine].Speaker</p>
                            <p class="ultima-dialog__line" aria-live="polite">@_view.Lines[_view.CurrentLine].Text</p>
                            @if (!_view.Thinking && !string.IsNullOrEmpty(_view.ReplySource) && _view.Lines[_view.CurrentLine].Speaker != "Você")
                            {
                                <SUIText Typo="SUITypo.caption" Color="SUIColor.Secondary">✦ origem da resposta: @_view.ReplySource</SUIText>
                            }
                            <form class="ultima-dialog__compose" @onsubmit="SubmitDialogAsync" @onsubmit:preventDefault="true">
                                <label class="sr-only" for="dialog-input">Escreva para a Guardiã</label>
                                <SUITextField TValue="string" Id="dialog-input" Placeholder="Escreva algo para a Guardiã…"
                                              MaxLength="300" Immediate="true" @bind-Value="_dialogDraft" />
                                <SUIButton ButtonTypeValue="SUIButtonType.Submit" SizeValue="SUISize.Small" StartIcon="send"
                                           aria-label="Enviar para a Guardiã">Enviar</SUIButton>
                                <SUIButton SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined" StartIcon="audio"
                                           OnClick="ToggleDictationAsync">@(_dictating ? "Parar ditado" : "Ditar")</SUIButton>
                            </form>
                            @if (!string.IsNullOrEmpty(_speechError))
                            {
                                <SUIText Typo="SUITypo.caption" Color="SUIColor.Error">@_speechError</SUIText>
                            }
                            <SUIStack Row="true" Spacing="2" Wrap="true">
                                <SUIButton OnClick="AdvanceAsync">@(_view.CurrentLine + 1 < _view.Lines.Count ? "Continuar · E/A" : "Encerrar · E/A")</SUIButton>
                                <SUIButton VariantValue="SUIVariant.Outlined" OnClick="CloseDialog">Fechar · Esc</SUIButton>
                            </SUIStack>
                        </SUIStack>
                    </SUICardContent>
                </SUICard>
            </section>
        }
    </main>
</div>

