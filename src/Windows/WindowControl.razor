@using Sufficit.Blazor.UI.Components

@if (State.Visible(Control))
{
    @switch (Control.Type)
    {
        case "transcript" when State.Conversation is { } conversation:
            <ConversationTranscript View="conversation" Archived="State.ArchivedTurns" />
            break;
        case "status":
            <SUIText Typo="SUITypo.caption" role="status">@State.Content(Control)</SUIText>
            break;
        case "note":
            <SUIText Typo="SUITypo.caption" Color="@(Control.Style == "error" ? SUIColor.Error : SUIColor.Secondary)">
                @State.Content(Control)
            </SUIText>
            break;
        case "row":
            <SUIStack Row="true" Spacing="2" Wrap="true">@Children</SUIStack>
            break;
        case "form":
            <form class="ultima-dialog__compose" @onsubmit="Dispatch" @onsubmit:preventDefault="true">@Children</form>
            break;
        case "input":
            <label class="sr-only" for="@Control.Id">@Control.Label</label>
            <SUITextField TValue="string" Id="@Control.Id" Placeholder="@Control.Text" MaxLength="@(Control.MaxLength ?? 300)"
                          Immediate="true" Value="@State.Content(Control)" ValueChanged="Edit" />
            break;
        case "submit":
            <SUIButton ButtonTypeValue="SUIButtonType.Submit" SizeValue="SUISize.Small" StartIcon="@Control.Icon"
                       Disabled="@Disabled" aria-label="@Control.Label">@State.Content(Control)</SUIButton>
            break;
        case "button":
            <SUIButton VariantValue="@(Control.Style == "outline" ? SUIVariant.Outlined : SUIVariant.Filled)"
                       SizeValue="@(Control.Style == "outline" ? SUISize.Small : SUISize.Medium)" StartIcon="@Control.Icon"
                       Disabled="@Disabled" OnClick="Dispatch">@State.Content(Control)</SUIButton>
            break;
        case "list":
            <ul class="ultima-window__list">
                @foreach (var item in Items)
                {
                    <li><SUIText>@item</SUIText></li>
                }
            </ul>
            break;
    }
}

@code {
    [Parameter, EditorRequired] public GameControl Control { get; set; } = default!;
    [Parameter, EditorRequired] public WindowState State { get; set; } = default!;
    [Parameter] public EventCallback<string> OnAction { get; set; }
    [Parameter] public EventCallback<(string Key, string Value)> OnEdit { get; set; }

    private bool Disabled => State.Read(Control.DisabledWhen).Length != 0;

    private IReadOnlyList<string> Items => Control.Bind is { } key && State.Lists.TryGetValue(key, out var items) ? items : [];

    private RenderFragment Children => @<text>
        @foreach (var child in Control.Children ?? [])
        {
            <WindowControl Control="child" State="State" OnAction="OnAction" OnEdit="OnEdit" />
        }
    </text>;

    private Task Dispatch() => Control.Action is { } action ? OnAction.InvokeAsync(action) : Task.CompletedTask;
    private Task Edit(string value) => Control.Bind is { } key ? OnEdit.InvokeAsync((key, value)) : Task.CompletedTask;
}
