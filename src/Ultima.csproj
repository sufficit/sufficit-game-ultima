<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ultima</RootNamespace>
    <AssemblyName>Ultima</AssemblyName>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>

  <!-- Contrato comum dos modelos 3D. Fica inteiro (sem trimming): os pacotes de modelos
       carregados em runtime usam partes do Core que o jogo em si não chama. -->
  <ItemGroup>
    <ProjectReference Include="../models/Ultima.Models.Core/Ultima.Models.Core.csproj" />
    <TrimmerRootAssembly Include="Ultima.Models.Core" />
  </ItemGroup>

</Project>
