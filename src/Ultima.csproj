<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ultima</RootNamespace>
    <AssemblyName>Ultima</AssemblyName>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
    <PackageReference Include="Sufficit.AI.Genius.Embedded" Version="[0.1.0-preview.1]" />
    <PackageReference Include="Sufficit.Blazor.UI" Version="2.26.1102.2231" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Windows/Layouts/*.json" />
    <Compile Include="../app/PlayerIdentity.cs" Link="Browser/PlayerIdentity.cs" />
    <Compile Include="../app/GuardianQuality.cs" Link="Telemetry/GuardianQuality.cs" />
    <Compile Include="../app/Missions.cs" Link="Environments/Missions.cs" />
    <Compile Include="../engine/Ultima.Terrain/AnimationTimeline.cs" Link="Terrain/AnimationTimeline.cs" />
    <Compile Include="../engine/Ultima.Terrain/Terrain*.cs" Link="Terrain/%(Filename)%(Extension)" />
    <Compile Include="../engine/Ultima.Terrain/BrowserExports*.cs" Link="Terrain/%(Filename)%(Extension)" />
    <Compile Include="../engine/Ultima.Terrain/Player*.cs" Link="Terrain/%(Filename)%(Extension)" />
    <Compile Include="../engine/Ultima.Terrain/World*.cs" Link="Terrain/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Contrato comum dos modelos 3D. Fica inteiro (sem trimming): os pacotes de modelos
       carregados em runtime usam partes do Core que o jogo em si não chama. -->
  <ItemGroup>
    <ProjectReference Include="../models/Ultima.Models.Core/Ultima.Models.Core.csproj" />
    <TrimmerRootAssembly Include="Ultima.Models.Core" />
  </ItemGroup>

</Project>
